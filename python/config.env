# ═══════════════ WettBot – Einstellungen ═══════════════
# Format: NAME=Wert   (Zeilen mit # sind Kommentare)

# ── Zugangsdaten ──
# Kostenloser Key: https://the-odds-api.com  (500 Credits/Monat gratis)
ODDS_API_KEY=
# Optional – Telegram-Benachrichtigung (siehe ANLEITUNG.html)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Was wird gescannt ──
# Keys mit "python wettbot.py --sportarten" anzeigen. Präfix geht auch: tennis_atp = alle ATP-Turniere
# Jede Liga kostet pro Scan: Anzahl Märkte × Regionen Credits
SPORTARTEN=soccer_germany_bundesliga,soccer_epl,soccer_uefa_champs_league
# h2h = Sieger/1X2 · totals = Über/Unter   (h2h,totals = doppelte Credits)
MAERKTE=h2h
REGION=eu

# ── Buchmacher ──
# Referenz für faire Quoten (scharfer Buchmacher mit kleiner Marge)
SHARP_BUCHMACHER=pinnacle
# Wo DU wettest (nur deutsche Lizenz!). Leer = alle.
# Mögliche Keys: tipico_de, winamax_de, williamhill, betsson, sport888, unibet_nl, betvictor, nordicbet ...
ZIEL_BUCHMACHER=tipico_de,winamax_de

# ── Filter ──
MIN_VALUE_PROZENT=2
# Mehr als das = vermutlich Fehler/veraltete Quote
MAX_VALUE_PROZENT=25
MIN_QUOTE=1.30
MAX_QUOTE=6.00
# Ohne Pinnacle: Konsens aus mind. so vielen Buchmachern
MIN_BUECHER_KONSENS=5
# Falls dein Buchmacher 5 % Steuer vom Gewinn abzieht: 5
WETTSTEUER_PROZENT=0
# Nur Spiele in den nächsten X Stunden
VORLAUF_STUNDEN=72
# Laufende Spiele mitscannen (riskant: Quoten ändern sich sekündlich)
LIVE_SPIELE=nein
# Quoten älter als X Minuten ignorieren (0 = nie)
MAX_QUOTEN_ALTER_MIN=0

# ── Einsatz ──
BANKROLL=200
# 0.25 = ¼ Kelly (empfohlen)
KELLY_ANTEIL=0.25
# Nie mehr als X % der Bankroll pro Wette
MAX_EINSATZ_PROZENT=3

# ── Zeitplan ──
# 0 = automatisch: Credits werden gleichmäßig bis Monatsende verteilt
INTERVALL_MIN=0
MIN_INTERVALL_MIN=20
# So viele Credits bleiben immer übrig
CREDIT_RESERVE=20
BERICHT_OEFFNEN=ja
